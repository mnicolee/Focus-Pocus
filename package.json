{
  "name": "focus-pocus",
  "version": "2.0.0",
  "description": "Customized productivity timer with activity detection",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "node run-dev.js .",
    "build": "electron-builder --win portable"
  },
  "keywords": ["productivity", "timer", "pomodoro"],
  "author": "",
  "license": "Apache-2.0",
  "build": {
